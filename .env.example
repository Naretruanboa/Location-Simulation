HOST=127.0.0.1
PORT=8000
# iphone, android, or mock
GPS_PROVIDER=android
MOVEMENT_HZ=10
DEFAULT_SPEED_KMH=5
# DEBUG logs connection and HTTP method/path/status. INFO is quieter.
LOG_LEVEL=INFO
DATABASE_PATH=data/app.db
GEOCODER_URL=https://nominatim.openstreetmap.org

# BlueStacks Air example:
ADB_PATH=/Applications/BlueStacks.app/Contents/MacOS/hd-adb
ADB_ENDPOINTS=127.0.0.1:5555

# macOS native tunnel needs no sudo; set tunneld for a separately managed tunnel.
IOS_TRANSPORT=native
